APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
PURCHASE_NOTIFICATION_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_MAIL_ADDRESS=info@valzeria.com
ADMIN_EMAIL=
CONTACT_MAIL_HOST=
CONTACT_MAIL_PORT=995
CONTACT_MAIL_USERNAME=
CONTACT_MAIL_PASSWORD=
CONTACT_MAIL_ENCRYPTION=ssl
CONTACT_MAIL_FETCH_LIMIT=30
CONTACT_MAIL_SMTP_HOST=
CONTACT_MAIL_SMTP_PORT=465
CONTACT_MAIL_SMTP_ENCRYPTION=ssl
CONTACT_MAIL_FROM_NAME="ヴァルゼリアの冒険者 運営"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PvE enemy -> player direct-damage formula. Set false only to temporarily use the legacy formula.
PVE_ENEMY_PERCENTAGE_DEFENSE_ENABLED=true
PVE_ENEMY_DEFENSE_COEFFICIENT=3.5

# Six Heroes release gate. Production remains on the legacy arena while false.
SIX_HERO_UI_ENABLED=false
# Six Heroes-only agility breakthrough. Keep false unless the balance release is explicitly enabled.
PVP_SPEED_BREAKTHROUGH_ENABLED=false
# Nation dashboard preview is visible, while all nation gameplay remains disabled.
NATION_SCREEN_ENABLED=true
NATION_COMMUNITY_ENABLED=false
NATION_WAR_ENABLED=false
# Release checks default to the validated production-compatible MariaDB baseline.
SIX_HERO_EXPECTED_DATABASE_PRODUCT=mariadb
SIX_HERO_MINIMUM_DATABASE_VERSION=10.5.13
SIX_HERO_STALE_BATTLE_MINUTES=30
SIX_HERO_FAILED_BATTLE_WINDOW_HOURS=24
SIX_HERO_OPERATIONS_BATTLE_LIST_LIMIT=20

# Job art v2 prototype flags. Keep disabled until explicitly enabled.
BATTLE_JOB_ART_PVP_SET=false
BATTLE_JOB_ART_PRESETS=false
BATTLE_JOB_ART_LOADOUT_V2=false
BATTLE_JOB_ART_LOADOUT_CARD_DETAILS=false
BATTLE_JOB_ART_DYNAMIC_SINGLE=false
BATTLE_JOB_ART_NORMALIZED_SP=false
BATTLE_JOB_ART_HIT_RESOLUTION=false
BATTLE_JOB_ART_DAMAGE_APPLICATION=false
BATTLE_JOB_ART_RESOURCES=false
BATTLE_JOB_ART_FIELDS=false
BATTLE_JOB_ART_PENETRATION=false
BATTLE_JOB_ART_PENETRATION_STANCE=false
# Ten-lineage C-design and ultimate counterplay remain disabled by default.
BATTLE_JOB_ART_C_DESIGN_PROTOTYPE=false
BATTLE_JOB_ART_ULTIMATE_COUNTERPLAY=false
BATTLE_JOB_ART_FLAVOR_REWRITE=false

# Keep current weapon/armor restrictions until this is explicitly enabled.
EQUIPMENT_PROFICIENCY_PENALTY_ENABLED=false
EQUIPMENT_NON_PROFICIENT_EFFECT_RATE=0.65

# Character icon design and submission are public by default.
CHARACTER_ICON_DESIGN_ENABLED=true
CHARACTER_ICON_DESIGN_PREVIEW_CHARACTER_IDS=

POCHI_GAME_PORTAL_ENABLED=false
POCHI_GAME_PORTAL_ENDPOINT=https://games-alchemist.com/api/portal/online-count/
POCHI_GAME_PORTAL_GAME_KEY=
POCHI_GAME_PORTAL_API_KEY=
POCHI_GAME_PORTAL_ONLINE_WINDOW_MINUTES=5

# PWA Web Push modes: off, allowlist, all. VAPID keys are always required.
WEB_PUSH_MODE=off
# Used only when WEB_PUSH_MODE=allowlist.
WEB_PUSH_ALLOWED_CHARACTER_IDS=
# Non-production only. Production is fixed to Val's exact character ID in config/web_push.php.
ADMIN_WEB_PUSH_CHARACTER_ID=
# generic: fixed text; title: sanitized bell title only. Bell body is never sent.
WEB_PUSH_PREVIEW_MODE=generic
WEB_PUSH_VAPID_SUBJECT="${APP_URL}"
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_TTL=3600
WEB_PUSH_BATCH_SIZE=20
